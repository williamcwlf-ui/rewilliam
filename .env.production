# Placeholder environment variables for Vercel/production builds for the rewilliam kit.
# Replace every value with real credentials before going to a public deployment.
# This file contains placeholders only so Vercel's build-time validator succeeds during import.
# DO NOT commit real secrets to the repository.

NODE_ENV=production
NEXT_PUBLIC_VERCEL_ENV=production

# Data stores
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?tls=true
MONGODB_DATABASE=rewilliam
REDIS_URL=rediss://:password@redis-host:6379

# CDN / S3-compatible storage
CDN_ENDPOINT=https://nyc3.digitaloceanspaces.com
CDN_REIGON=nyc3
CDN_BUCKET_NAME=your-bucket-name
CDN_ACCESS_KEY_ID=SPACES_ACCESS_KEY
CDN_SECRET_ACCESS_KEY=SPACES_SECRET_KEY
CDN_URL=https://cdn.example.com

# Crypto / JWT
# CRYPTO_KEY must be EXACTLY 32 characters
CRYPTO_KEY=0123456789abcdef0123456789abcdef
JSON_WEB_TOKEN_SECRET=your_jwt_secret_here

# OAuth / Integrations (placeholders)
DISCORD_CLIENT_ID=discord_client_id
DISCORD_CLIENT_SECRET=discord_client_secret
DISCORD_TOKEN=discord_bot_token
DISCORD_PUBLIC_KEY=discord_public_key
NEXT_PUBLIC_DISCORD_CLIENT_ID=discord_client_id

# Roblox
ROBLOX_API_KEY=roblox_open_cloud_key
ROBLOX_CLIENT_ID=roblox_oauth_client_id
ROBLOX_CLIENT_SECRET=roblox_oauth_client_secret
ROBLOX_COOKIE=.ROBLOSECURITY_cookie_here
ROBLOX_USER_ID=123456789

# Stripe (optional)
STRIPE_PUBLIC=pk_test_xxx_or_pk_live_xxx
STRIPE_SECRET=sk_test_xxx_or_sk_live_xxx
STRIPE_SIGNING_SECRET=whsec_xxx

# Misc
BLOXLINK_TOKEN=bloxlink_token_here
SELF_HOSTED=true
APP_NAME=panel

# Required-by-schema but unused placeholders
ROBLOX_SECRET=placeholder
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
CONTIGUITY_SECRET=placeholder

# Recommended for build so devDependencies install
NPM_CONFIG_PRODUCTION=false
